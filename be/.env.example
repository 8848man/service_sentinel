# Application Settings
APP_NAME=ServiceSentinel
APP_VERSION=1.0.0
DEBUG=False

# Database (Choose one)
# SQLite (Development)
DATABASE_URL=sqlite:///./servicesentinel.db

# PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@localhost:5432/servicesentinel

# AI Configuration
AI_ENABLED=False
AI_API_KEY=your-openai-api-key-here
AI_MODEL=gpt-4-turbo
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.3

# Monitoring Configuration
DEFAULT_CHECK_INTERVAL_SECONDS=60
DEFAULT_TIMEOUT_SECONDS=10
DEFAULT_FAILURE_THRESHOLD=3
CONCURRENT_CHECKS_LIMIT=50

# Scheduler Configuration
SCHEDULER_ENABLED=True
MONITORING_INTERVAL_SECONDS=30

# Security
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32
# ENCRYPTION_KEY=generate-with-cryptography-fernet-generate_key

# CORS (Add your frontend URLs)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
